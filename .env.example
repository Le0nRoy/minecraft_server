# Minecraft Server Configuration
MINECRAFT_VERSION=1.21.1
NEOFORGE_VERSION=21.1.244

# JVM Memory Settings
SERVER_MEMORY_MIN=2G
SERVER_MEMORY_MAX=8G

# Network Ports
SERVER_PORT=25565
RCON_PORT=25575
RCON_PASSWORD=change_me_rcon_pass
HEALTHCHECK_PORT=8080
AUTH_SIDECAR_PORT=8181

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Backup Settings
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
# World folder name inside the Docker volume (default: world)
LEVEL=world

# System
TZ=UTC
COMPOSE_PROJECT_NAME=minecraft-server

# Feature Flags
ENABLE_TELEGRAM=true
ENABLE_MONITORING=false

# Auth: ONLINE_MODE and ENFORCE_SECURE_PROFILE are hardcoded to false in
# server/docker-compose.yml and cannot be overridden via this file.
# Offline mode is intentional — network access is restricted to Tailscale.
