[Unit]
Description=Minecraft Modded Server (Docker Compose)
Documentation=https://github.com/itzg/docker-minecraft-server
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/minecraft-infra/server
EnvironmentFile=/opt/minecraft-infra/.env

ExecStartPre=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down --timeout 30
ExecReload=/usr/bin/docker compose restart

# Restart settings
Restart=on-failure
RestartSec=30s
StartLimitIntervalSec=300
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=minecraft-server

[Install]
WantedBy=multi-user.target
